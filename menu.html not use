user.email||"-";


$("userName")
.textContent=
user.displayName||
"Tailor Manager";


await loadCounts();

}
);


/* =====================================================
   LOAD COUNTS
===================================================== */

async function loadCounts(){

try{


const customerSnap=
await getDocs(

collection(

db,

"users",

currentUser.uid,

"customers"

)

);


const orderSnap=
await getDocs(

collection(

db,

"users",

currentUser.uid,

"orders"

)

);


$("customerCount")
.textContent=
customerSnap.size;


$("orderCount")
.textContent=
orderSnap.size;


}catch(error){

console.error(error);

message(
"Data count لوڈ نہیں ہو سکا۔",
"error"
);

}

}


/* =====================================================
   EXPORT BACKUP
===================================================== */

async function exportBackup(){

if(!currentUser){

message(
"پہلے Login کریں۔",
"error"
);

return;

}


const button=
$("exportBtn");

button.disabled=true;

message(
"Backup تیار ہو رہا ہے...",
"info"
);

progress(
10,
"Customers پڑھ رہے ہیں..."
);


try{


/* ================================================
   CUSTOMERS
================================================ */

const customerSnap=
await getDocs(

collection(

db,

"users",

currentUser.uid,

"customers"

)

);


progress(
35,
"Customers محفوظ ہو رہے ہیں..."
);


const customers=
customerSnap.docs.map(
item=>({

id:item.id,

data:
serializeValue(
item.data()
)

})
);


/* ================================================
   ORDERS
================================================ */

progress(
50,
"Orders پڑھ رہے ہیں..."
);


const orderSnap=
await getDocs(

collection(

db,

"users",

currentUser.uid,

"orders"

)

);


progress(
70,
"Orders محفوظ ہو رہے ہیں..."
);


const orders=
orderSnap.docs.map(
item=>({

id:item.id,

data:
serializeValue(
item.data()
)

})
);


/* ================================================
   BACKUP OBJECT
================================================ */

const now=
new Date();


const backup={

backupVersion:
"1.0",

backupType:
"Tailor Manager Full Backup",

createdAt:
now.toISOString(),

sourceProject:
firebaseConfig.projectId,

sourceUser:
currentUser.uid,

sourceEmail:
currentUser.email||"",

data:{

customers:
customers,

orders:
orders

}

};


/* ================================================
   JSON
================================================ */

progress(
82,
"Backup فائل بن رہی ہے..."
);


const json=
JSON.stringify(
backup,
null,
2
);


/* ================================================
   BLOB
================================================ */

const blob=
new Blob(
[json],
{
type:
"application/json"
}
);


/* ================================================
   FILE NAME
================================================ */

const year=
now.getFullYear();


const month=
String(
now.getMonth()+1
).padStart(
2,
"0"
);


const day=
String(
now.getDate()
).padStart(
2,
"0"
);


const hour=
String(
now.getHours()
).padStart(
2,
"0"
);


const minute=
String(
now.getMinutes()
).padStart(
2,
"0"
);


const fileName=
`Tailor-Backup-${year}-${month}-${day}-${hour}-${minute}.json`;


/* ================================================
   DOWNLOAD
================================================ */

progress(
92,
"Backup موبائل میں محفوظ ہو رہا ہے..."
);


const url=
URL.createObjectURL(
blob
);


const a=
document.createElement(
"a"
);

a.href=url;

a.download=
fileName;

document.body.appendChild(
a
);

a.click();

a.remove();


setTimeout(
()=>URL.revokeObjectURL(url),
2000
);


progress(
100,
"Backup مکمل ہو گیا ✓"
);


message(
`✅ Backup تیار ہے: ${fileName}`,
"success"
);


hideProgress();


button.disabled=false;


}catch(error){

console.error(error);


hideProgress();


button.disabled=false;


message(
"❌ Backup نہیں بن سکا: "+
error.message,
"error"
);

}

}


/* =====================================================
   IMPORT BUTTON
===================================================== */

$("importBtn").onclick=()=>{

$("fileInput").click();

};


/* =====================================================
   FILE SELEC
===================================================== */

$("fileInput").addEventListener(
"change",
async event=>{

const file=
event.target.files[0];


if(!file){

return;

}


await importBackup(
file
);


/*
دوبارہ وہی file select کرنے
کی اجازت کے لیے reset
*/

event.target.value="";

}
);


/* =====================================================
   IMPORT BACKUP
===================================================== */

async function importBackup(
file
){

if(!currentUser){

message(
"پہلے Login کریں۔",
"error"
);

return;

}


const button=
$("importBtn");

button.disabled=true;


try{


progress(
5,
"Backup فائل پڑھی جا رہی ہے..."
);


const text=
await file.text();


progress(
15,
"Backup چیک کیا جا رہا ہے..."
);


let backup;


try{

backup=
JSON.parse(
text
);

}catch(error){

throw new Error(
"یہ صحیح Tailor Backup JSON فائل نہیں ہے۔"
);

}


/* ================================================
   VALIDATION
================================================ */

if(
!backup ||
!backup.data
){

throw new Error(
"Backup فائل کا Data موجود نہیں ہے۔"
);

}


if(
!Array.isArray(
backup.data.customers
)
){

throw new Error(
"Customers Data خراب یا موجود نہیں ہے۔"
);

}


if(
!Array.isArray(
backup.data.orders
)
){

throw new Error(
"Orders Data خراب یا موجود نہیں ہے۔"
);

}


/* ================================================
   CONFIRM
================================================ */

const customerTotal=
backup.data.customers.length;


const orderTotal=
backup.data.orders.length;


const confirmed=
confirm(

`Backup Import کرنا ہے؟

Customers: ${customerTotal}

Orders: ${orderTotal}

Existing Data delete نہیں ہوگا۔
Backup کا Data موجودہ Account میں
دوبارہ شامل/Restore ہوگا۔

کیا آپ جاری رکھنا چاہتے ہیں؟`

);


if(!confirmed){

button.disabled=false;

hideProgress();

return;

}


/* ================================================
   PREPARE ALL RECORDS
================================================ */

const records=[];


/*
Customers
*/

for(
const item
of backup.data.customers
){

if(
!item.id
){

continue;

}


records.push({

type:
"customers",

id:
item.id,

data:
deserializeValue(
item.data||{}
)

});

}


/*
Orders
*/

for(
const item
of backup.data.orders
){

if(
!item.id
){

continue;

}


records.push({

type:
"orders",

id:
item.id,

data:
deserializeValue(
item.data||{}
)

});

}


/* ================================================
   FIRESTORE BATCH
   Maximum 500 writes per batch
================================================ */

const total=
records.length;


let completed=
0;


const batchSize=
450;


for(
let start=0;
start<records.length;
start+=batchSize
){

const batch=
writeBatch(
db
);


const part=
records.slice(
start,
start+batchSize
);


for(
const record
of part
){

const reference=
doc(

db,

"users",

currentUser.uid,

record.type,

record.id

);


batch.set(

reference,

record.data,

{
merge:true
}

);

}


await batch.commit();


completed+=
part.length;


const percent=
20+
Math.round(
(completed/total)*75
);


progress(

Math.min(
95,
percent
),

`Data Restore ہو رہا ہے... ${completed}/${total}`

);

}


/* ================================================
   COMPLETE
================================================ */
   progress(
100,
"Import مکمل ہو گیا ✓"
);


await loadCounts();


message(

`✅ Backup کامیابی سے Restore ہوگیا۔ Customers: ${customerTotal} — Orders: ${orderTotal}`,

"success"

);


hideProgress();


button.disabled=false;


}catch(error){

console.error(error);


hideProgress();


button.disabled=false;


message(

"❌ Backup Import نہیں ہو سکا: "+
error.message,

"error"

);

}

}


/* =====================================================
   REFRESH
===================================================== */

$("refresh").onclick=
async()=>{

message(
"Data refresh ہو رہا ہے...",
"info"
);

await loadCounts();

message(
"✅ Data تازہ ہوگیا۔",
"success"
);

setTimeout(
()=>{

message(
"",
"info"
);

},
2500
);


/* =====================================================
   EXPORT
===================================================== */

};


$("exportBtn").onclick=
exportBackup;


</script>

</body>

</html>
