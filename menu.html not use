/* =====================================================
   PROGRESS
===================================================== */

function progress(
percent,
text
){

$("progressBox")
.classList.add("show");

$("progressBar")
.style.width=
percent+"%";

$("progressText")
.textContent=
text;

}


function hideProgress(){

setTimeout(
()=>{

$("progressBox")
.classList.remove(
"show"
);

$("progressBar")
.style.width=
"0%";

},
1000
);

}


/* =====================================================
   FIRESTORE TIMESTAMP → JSON
===================================================== */

function serializeValue(
value
){

/*
Firestore Timestamp
*/

if(
value instanceof Timestamp
){

return{

__type:
"timestamp",

seconds:
value.seconds,

nanoseconds:
value.nanoseconds

};

}


/*
Array
*/

if(
Array.isArray(value)
){

return value.map(
serializeValue
);

}


/*
Object
*/

if(
value &&
typeof value==="object"
){

const result={};

for(
const key
of Object.keys(value)
){

result[key]=
serializeValue(
value[key]
);

}

return result;

}


/*
Normal value
*/

return value;

}


/* =====================================================
   JSON → FIRESTORE
===================================================== */

function deserializeValue(
value
){

if(
Array.isArray(value)
){

return value.map(
deserializeValue
);

}


if(
value &&
typeof value==="object"
){

if(
value.__type===
"timestamp"
){

return Timestamp.fromMillis(

(
Number(value.seconds)||0
)*1000
+
Math.floor(
(
Number(value.nanoseconds)||0
)/1000000
)

);

}


const result={};

for(
const key
of Object.keys(value)
){

result[key]=
deserializeValue(
value[key]
);

}

return result;

}


return value;

}


/* =====================================================
   AUTH
===================================================== */

onAuthStateChanged(
auth,
async user=>{

if(!user){

location.replace(
"login.html"
);

return;

}

currentUser=user;


/*
User information
*/

$("userEmail")
